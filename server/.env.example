# Copy this file to server/.env and fill in real values.

# Server
PORT=4000

# MongoDB connection string (local default, or a MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/prospera

# Auth — set JWT_SECRET to a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google sign-in (optional). Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and paste the Client ID here.
# Leave blank to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed browser origins for CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Mistral AI (optional) — powers AI ATS scoring + resume enhancement. Get a key at
# https://console.mistral.ai/. Leave blank to disable AI (falls back to the
# deterministic keyword heuristic). The key stays server-side, never sent to the browser.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# OCR model used to read uploaded PDFs/images (incl. scanned résumés).
MISTRAL_OCR_MODEL=mistral-ocr-latest
