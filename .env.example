# Frontend env (Vite). Copy to .env.local for local dev.

# Optional: point the frontend at a different API base. Defaults to "/api"
# (proxied to the Express server in dev — see vite.config.js).
# VITE_API_URL=http://localhost:4000/api

# Google sign-in: the SAME OAuth 2.0 Web Client ID used by the server.
# Leave blank to hide the "Sign in with Google" button (email/password still works).
VITE_GOOGLE_CLIENT_ID=
